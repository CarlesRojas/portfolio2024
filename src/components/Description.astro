---
import type { Project } from '@data/projects';
import Section from '@layouts/Section.astro';

interface Props {
    project: Project;
}

const { description, process } = Astro.props.project;
---

<Section title="Description" smallGap>
    <div class="relative w-full h-fit flex flex-col items-center gap-8 max-w-xl">
        <div class="relative w-full h-fit flex flex-col items-center gap-2">
            {description.map((paragraph) => <p class="text-left opacity-90">{paragraph}</p>)}
        </div>

        <div class="relative w-full h-fit flex flex-col items-center gap-2">
            <p class="text-sm text-left opacity-60">{process}</p>
        </div>
    </div>
</Section>
